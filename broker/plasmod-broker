def attach(tid, name):
    import os
    import shutil
    import tempfile
    base = name.strip()
    if not base or base != os.path.basename(base) or base.startswith(".") or len(base) > 120 or "\0" in base:
        die(f"不正なファイル名: {name!r}")
    data = sys.stdin.buffer.read(MAX_ATTACH + 1)
    if len(data) > MAX_ATTACH:
        die("25MB を超えている")
    os.makedirs(WORK_TMP, mode=0o700, exist_ok=True)
    d = tempfile.mkdtemp(prefix="gh-attach-", dir=WORK_TMP)
    try:
        path = os.path.join(d, base)
        with open(path, "wb") as f:
            f.write(data)
        kanban("attach", "--author", AUTHOR, "--name", base, tid, path)
    finally:
        shutil.rmtree(d, ignore_errors=True)


INBOX_DIR = os.path.join(HERMES_HOME, "plasmod-inbox")
INBOX_KEEP = 30 * 86400
MODELS_FILE = "/etc/plasmod-models.json"
PROFILE_RE = re.compile(r"^[a-z0-9][a-z0-9_-]{0,31}$")


def put_file(name):
    """チャットの添付を、エージェントが読める場所に置く。30日より古いものはここで片付ける。"""
    base = name.strip()
    if not base or base != os.path.basename(base) or base.startswith(".") or len(base) > 120 or "\0" in base:
        die(f"不正なファイル名: {name!r}")
    data = sys.stdin.buffer.read(MAX_ATTACH + 1)
    if len(data) > MAX_ATTACH:
        die("25MB を超えている")
    os.makedirs(INBOX_DIR, mode=0o755, exist_ok=True)
    now = time.time()
    for old in os.listdir(INBOX_DIR):
        q = os.path.join(INBOX_DIR, old)
        try:
            if os.path.isfile(q) and not os.path.islink(q) and now - os.path.getmtime(q) > INBOX_KEEP:
                os.remove(q)
        except OSError:
            pass
    path = os.path.join(INBOX_DIR, f"{int(now * 1000)}-{base}")
    with open(path, "xb") as f:
        f.write(data)
    print(path)


def profiles():
    out = {"default": HERMES_HOME}
    pdir = os.path.join(HERMES_HOME, "profiles")
    if os.path.isdir(pdir):
        for name in sorted(os.listdir(pdir)):
            if PROFILE_RE.match(name) and os.path.isdir(os.path.join(pdir, name)):
                out[name] = os.path.join(pdir, name)
    return out


def endpoints():
    """アプリが Hermes の API につなぐ先。API_SERVER_KEY のあるプロファイルだけ（キーはアプリのメモリにだけ置く）"""
    try:
        with open(os.path.join(HERMES_HOME, "config.yaml"), encoding="utf-8") as f:
            multiplex = bool(re.search(r"^\s*multiplex_profiles:\s*true\s*$", f.read(), re.M))
    except OSError:
        multiplex = False
    found = {}
    for name, home in profiles().items():
        env = {}
        try:
            with open(os.path.join(home, ".env"), encoding="utf-8") as f:
                for line in f:
                    k, sep, v = line.strip().partition("=")
                    if sep and k in ("API_SERVER_KEY", "API_SERVER_PORT"):
                        env[k] = v.strip().strip("'\"")
        except OSError:
            continue
        if env.get("API_SERVER_KEY"):
            found[name] = env
    base = found.get("default", {}).get("API_SERVER_PORT") or "8642"
    out = {}
    for name, env in found.items():
        if multiplex:
            url = f"http://127.0.0.1:{base}" + ("" if name == "default" else f"/p/{name}")
        else:
            url = f"http://127.0.0.1:{env.get('API_SERVER_PORT') or '8642'}"
        out[name] = {"url": url, "key": env["API_SERVER_KEY"]}
    print(json.dumps(out))


def usage():
    now = time.time()
    res = {}
    for name, home in profiles().items():
        path = os.path.join(home, "state.db")
        if not os.path.exists(path):
            continue
        try:
            c = sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=5)
            c.row_factory = sqlite3.Row
            q = ("SELECT COALESCE(SUM(input_tokens + output_tokens + COALESCE(cache_write_tokens, 0)), 0) AS tokens, "
                 "COALESCE(SUM(COALESCE(actual_cost_usd, estimated_cost_usd, 0)), 0) AS cost, COUNT(*) AS sessions "
                 "FROM sessions WHERE started_at >= ?")
            win = {k: dict(c.execute(q, (now - sec,)).fetchone()) for k, sec in (("h5", 5 * 3600), ("d7", 7 * 86400), ("d30", 30 * 86400))}
            models = [dict(r) for r in c.execute(
                "SELECT COALESCE(model, '?') AS model, SUM(input_tokens + output_tokens) AS tokens, "
                "SUM(COALESCE(actual_cost_usd, estimated_cost_usd, 0)) AS cost FROM sessions "
                "WHERE started_at >= ? GROUP BY model ORDER BY tokens DESC LIMIT 5", (now - 30 * 86400,))]
            c.close()
            res[name] = {**win, "models": models}
        except sqlite3.Error as e:
            res[name] = {"error": str(e)[:200]}
    print(json.dumps(res, ensure_ascii=False))


