# /etc/plasmod/env（root:plasmod 0640）。値の意味は src/server/config.ts を参照
PLASMOD_PORT=8790
PLASMOD_ALLOWED_LOGINS=you@example.com
# アプリで呼ぶ持ち主の名前。設定の「このアプリについて」に出す開発者とリポジトリ（任意）
PLASMOD_OWNER_NAME=オーナー
# 「今日」「明日の朝」の基準（例 Asia/Tokyo）。無ければ OS の設定
# PLASMOD_TIMEZONE=
# PLASMOD_DEVELOPER=
# PLASMOD_REPO_URL=
PLASMOD_PUBLIC_URL=https://<マシン名>.<tailnet>.ts.net:8443
# Tailscale の入口（tailscale serve の転送先）
PLASMOD_TAILSCALE_SOCK=/run/plasmod/ts.sock
# 自動デプロイ・plasmod-rootd の知らせの受け口と、そのトークン
PLASMOD_NOTIFY_URL=http://127.0.0.1:8790/notify-relay
PLASMOD_NOTIFY_TOKEN=
PLASMOD_RENOTIFY_MIN=15
PLASMOD_RENOTIFY_MAX=3
# プロファイル名とアプリでの表示（Hermes のプロファイル名に合わせる）
# 無ければ アシスタント（default）と 開発（dev）の2つ
# 例は deploy/profiles.example.json。1行にして単引用符で囲む: PLASMOD_PROFILES='[{"id":"default","name":"アシスタント","initial":"ア","color":"#8FB8FF"}]'
PLASMOD_HUB_PROFILE=default
# 画面の承認でアプリがマージする（docs/INSTALL.md の「マージの承認」）。エージェントには渡さない
# PLASMOD_GITHUB_MERGE_TOKEN=
# PLASMOD_MERGE_METHOD=merge
