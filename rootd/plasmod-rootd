class Inspector:
    def __init__(self, cfg: Config):
        self.cfg = cfg
        self.slots = threading.BoundedSemaphore(INSPECT_CONCURRENCY)
        self.recent = []
        self.recent_lock = threading.Lock()

    def throttle(self, now=None):
        """読むだけでも、回数に上限を付ける（暴走しても root の負荷にならないように）"""
        now = time.time() if now is None else now
        with self.recent_lock:
            self.recent = [t for t in self.recent if now - t < 60]
            if len(self.recent) >= INSPECT_PER_MINUTE:
                raise Refuse("読み取りが多すぎる。1分待って", "rate_limited")
            self.recent.append(now)

