        """VPS の様子。自由な引数は取らない"""
        out = {}
        for key, argv in (("disk", ["df", "-h", "--output=target,size,used,avail,pcent", "/", "/home", "/var"]), ("memory", ["free", "-h"]), ("uptime", ["uptime"]), ("failed", [self.cfg.systemctl, "list-units", "--failed", "--plain", "--no-legend", "--no-pager"])):
            code, txt, _ = self._run(argv)
            out[key] = list(dict.fromkeys(txt.splitlines()))[:40] if code == 0 else None  # 同じディスクの行を重ねない
        code, txt, _ = self._run(["tailscale", "status", "--json"]) if shutil.which("tailscale") else (1, "", "")
        if code == 0:
            try:
                d = json.loads(txt)
                out["tailscale"] = {"state": d.get("BackendState"), "online": (d.get("Self") or {}).get("Online")}
            except ValueError:
                pass
        return out

    def run(self, item, arg):
        if item not in INSPECT_ITEMS:
            raise Refuse("知らない項目。使えるのは: " + " ".join(INSPECT_ITEMS), "bad_item")
        if arg is not None and not isinstance(arg, str):
            raise Refuse("引数の形が違う", "bad_arg")
        rx = INSPECT_ARG_RE.get(item)
        if rx and arg is not None and (not rx.match(arg) or ".." in arg):
            raise Refuse("引数の形が違う", "bad_arg")
        if item in ("hermes-code", "hermes-grep", "skill") and not arg:
            raise Refuse(f"{item} には引数が要る", "bad_arg")
        self.throttle()
        if not self.slots.acquire(blocking=False):
            raise Refuse("いま別の inspect が動いている。少し待って", "busy")
        try:
            if item == "units":
                data = self.units(arg)
            elif item == "system":
                data = self.system()
            elif item in ("gateway-log", "hermes-code", "hermes-grep", "skill"):
                op = {"gateway-log": "gateway-log", "hermes-code": "code", "hermes-grep": "grep", "skill": "skill"}[item]
                data = self.hermes(op, arg or "")
            else:
                prof = arg or ("default" if item == "hermes-config" else "*")
                if prof != "*" and not PROFILE_RE.match(prof):
                    raise Refuse("プロファイル名の形が違う", "bad_arg")
                op = {"hermes-config": "config", "hermes-cron": "cron", "hermes-mcp": "mcp", "env-keys": "env-keys", "skills": "skills"}[item]
                data = self.hermes(op, prof)
                if item == "env-keys":
                    data = {"plasmod": env_file_keys(self.cfg.app_env), "hermes": data}
        finally:
            self.slots.release()
        data = mask(data)
        if len(json.dumps(data, ensure_ascii=False).encode()) > INSPECT_MAX:
            raise Refuse("結果が大きすぎる。プロファイルや unit を絞って", "too_large")
        return data

    def _run(self, argv, env=None):
        try:
            p = subprocess.run(argv, capture_output=True, timeout=INSPECT_TIMEOUT, env=env, stdin=subprocess.DEVNULL)
        except subprocess.TimeoutExpired:
            raise Refuse("時間内に終わらなかった", "timeout")
        except OSError as e:
            raise Refuse(f"動かせない: {type(e).__name__}", "exec_failed")
        return p.returncode, p.stdout.decode("utf-8", "replace"), p.stderr.decode("utf-8", "replace")

    def hermes(self, op, prof):
        env = {"PATH": "/usr/local/bin:/usr/bin:/bin", "LANG": "C.UTF-8", "HOME": os.path.dirname(self.cfg.hermes_home.rstrip("/"))}
        argv = [*self.cfg.as_hermes, self.cfg.hermes_python, "-I", "-c", HERMES_HELPER, op, self.cfg.hermes_home, prof]
        code, out, err = self._run(argv, env)
        if code == 0:
            try:
                return json.loads(out)
            except ValueError:
                pass
        else:
            # 知らないプロファイルは、標準エラーに JSON で理由とプロファイルの一覧が出る
            try:
                e = json.loads(err.strip().splitlines()[-1])
                extra = f"（あるのは: {' '.join(e['profiles'])}）" if e.get("profiles") else ""
                raise Refuse(f"{e['error']}{extra}", "bad_arg")
            except (ValueError, IndexError, KeyError, TypeError):
                pass
        raise Refuse(f"読み取りに失敗した（終了コード {code}）", "helper_failed")

    def unit_ok(self, unit):
        return bool(UNIT_RE.match(unit)) and unit.startswith(tuple(self.cfg.unit_prefixes))

    def units(self, unit):
        if unit is not None and not self.unit_ok(unit):
            raise Refuse("見られる unit ではない（plasmod・hermes- の .service / .timer だけ）", "bad_arg")
        names = [unit] if unit else []
        if not unit:
            for kind in ("service", "timer"):
                _, out, _ = self._run([self.cfg.systemctl, "list-units", "--all", "--plain", "--no-legend", "--no-pager", f"--type={kind}"])
                names += [ln.split()[0] for ln in out.splitlines() if ln.split() and self.unit_ok(ln.split()[0])]
        props = "ActiveState,SubState,Result,ExecMainStatus,NRestarts,ActiveEnterTimestamp,StateChangeTimestamp,LastTriggerUSec,NextElapseUSecRealtime"
        out = {}
        for n in sorted(set(names))[:60]:
            _, txt, _ = self._run([self.cfg.systemctl, "show", n, "--no-pager", f"--property={props}"])
            out[n] = {k: v for k, v in (ln.split("=", 1) for ln in txt.splitlines() if "=" in ln) if v not in ("", "n/a")}
        data = {"units": out}
        if unit:
            _, txt, _ = self._run([self.cfg.journalctl, "-u", unit, "-n", str(JOURNAL_LINES), "--no-pager", "-o", "short-iso"])
            data["journal"] = txt.splitlines()[-JOURNAL_LINES:]
        return data


# ---------------------------------------------------------------- 部品（action）
#
# 決まった操作を、依頼者ではなく plasmod-rootd がスクリプトに組み立てて、いつもの依頼（digest・パスワード承認・1 回だけ）にする。
#   - 引数は形を決めて検査し、今の状態から「変わること」の下見を作る。下見と部品の記録は添付（preview.txt・action.json）に
#     入れるので digest に含まれる（見せた下見と違う内容は実行できない）
#   - スクリプトは: 対象ファイルの控え（backups/<ID>/）→ 変更 → 控えとの差分と確かめ
#   - Hermes の持ち物の読み書きは、控えを取るのも戻すのも hermes の権限で（root が hermes のパスを辿らない）
#   - 元に戻す（undo）: 終わった部品の依頼の控えに戻す。戻す前にも控えを取るので、戻したのをさらに戻せる

ACTIONS = {
    "cron.pause": ("profile", "job"),
    "cron.resume": ("profile", "job"),
    "mcp.enable": ("profile", "name"),
    "mcp.disable": ("profile", "name"),
    "service.restart": ("unit",),
    "config.set": ("profile", "key", "value"),
    "skill.sync": ("profile", "name"),
    "undo": ("id",),
}
# config.set で変えてよいキーと値。承認を緩める値（approvals.mode の off など）は入れない
CONFIG_ALLOW = {
    "approvals.mode": lambda v: v in ("manual", "smart"),
    "approvals.timeout": lambda v: v.isdigit() and 30 <= int(v) <= 3600,
}
# 再起動しない: 自分自身（実行中の依頼が切れる）
NO_RESTART = {"plasmod-rootd.service"}
ACTION_ARG_RE = {
    "profile": PROFILE_RE,
    "job": re.compile(r"^[A-Za-z0-9_-]{4,64}$"),
    "name": re.compile(r"^[A-Za-z0-9_-]{1,64}$"),
    "id": ID_RE,
    "unit": UNIT_RE,
    "key": re.compile(r"^[a-z_.]{1,64}$"),
    "value": re.compile(r"^[A-Za-z0-9_.-]{1,32}$"),
}
ACTION_TIMEOUT = 300
OWNER_COMMAND_MAX = 8000
UNDO_PREVIEW_LINES = 400


def sh(s: str) -> str:
    """bash の 1 語にする（引数は正規表現で検査済みだが、念のため必ずクォートする）"""
    return "'" + s.replace("'", "'\\''") + "'"


class Actions:
    def __init__(self, cfg: Config, engine, inspector):
        self.cfg = cfg
        self.engine = engine
        self.inspector = inspector

    @property
    def backup_root(self):
        return os.path.join(self.cfg.state_dir, "backups")

    def home_of(self, profile):
        return self.cfg.hermes_home if profile == "default" else os.path.join(self.cfg.hermes_home, "profiles", profile)

    def check_args(self, name, args):
        if name not in ACTIONS:
            raise Refuse("知らない部品。使えるのは: " + " ".join(ACTIONS), "bad_action")
        params = ACTIONS[name]
        if not isinstance(args, list) or len(args) != len(params) or not all(isinstance(a, str) for a in args):
            raise Refuse(f"{name} の引数は: " + " ".join(p.upper() for p in params), "bad_arg")
        for p, a in zip(params, args):
            if not ACTION_ARG_RE[p].match(a):
                raise Refuse(f"{p} の形が違う: {a[:80]}", "bad_arg")
        return dict(zip(params, args))

    # ---- 下見と手順 ----
    def plan(self, name, a):
        """返す: title・preview（文）・targets（控えを取るファイル）・steps（bash の行）・verify（確かめの bash の行）"""
        if name in ("cron.pause", "cron.resume"):
            home = self.home_of(a["profile"])
            jobs = self.inspector.hermes("cron", a["profile"])[a["profile"]]
            if not isinstance(jobs, list):
                raise Refuse("cron の一覧を読めない", "bad_state")
            job = next((j for j in jobs if j.get("id") == a["job"]), None)
            if not job:
                raise Refuse(f"{a['profile']} に cron {a['job']} は無い", "bad_arg")
            want = "paused" if name == "cron.pause" else "scheduled"
            if (job["state"] == "paused") == (want == "paused"):
                raise Refuse(f"もう {job['state']} になっている", "no_change")
            verb = name.split(".")[1]
            return {
                "title": f"部品 {name}: {a['profile']} / {job.get('name') or a['job']}",
                "preview": f"{a['profile']} / cron {a['job']}「{job.get('name') or ''}」（{job.get('schedule') or '-'}）\n  状態: {job['state']} → {want}",
                "targets": [os.path.join(home, "cron", "jobs.json")],
                "steps": [f"H {sh(home)} {sh(self.cfg.hermes_bin)} cron {verb} {sh(a['job'])}"],
                "verify": [f"H {sh(home)} {sh(self.cfg.hermes_bin)} cron list"],
            }
        if name in ("mcp.enable", "mcp.disable"):
            home = self.home_of(a["profile"])
            conf = self.inspector.hermes("config", a["profile"])[a["profile"]]
            srv = (conf.get("mcp_servers") or {}).get(a["name"]) if isinstance(conf, dict) else None
            if not srv:
                raise Refuse(f"{a['profile']} の config.yaml に MCP {a['name']} は無い", "bad_arg")
            want = name == "mcp.enable"
            if bool(srv.get("enabled")) == want:
                raise Refuse(f"もう {'有効' if want else '無効'}になっている", "no_change")
            where = srv.get("host") or srv.get("command") or "-"
            key = f"mcp_servers.{a['name']}.enabled"
            return {
                "title": f"部品 {name}: {a['profile']} / {a['name']}",
                "preview": f"{a['profile']} / MCP {a['name']}（{where}）\n  有効: {'はい' if srv.get('enabled') else 'いいえ'} → {'はい' if want else 'いいえ'}\n  トークンのファイルは触らない",
                "targets": [os.path.join(home, "config.yaml")],
                "steps": [f"H {sh(home)} {sh(self.cfg.hermes_bin)} config set {sh(key)} {'true' if want else 'false'}"],
                "verify": [f"H {sh(home)} {sh(self.cfg.hermes_bin)} config get {sh(key)}"],
            }
        if name == "service.restart":
            unit = a["unit"]
            if not self.inspector.unit_ok(unit) or not unit.endswith(".service") or unit in NO_RESTART:
                raise Refuse(f"{unit} は再起動できない", "bad_arg")
            info = self.inspector.units(unit)["units"].get(unit) or {}
            return {
                "title": f"部品 service.restart: {unit}",
                "preview": f"{unit} を再起動する\n  今の状態: {info.get('ActiveState', '?')} / {info.get('SubState', '?')}",
                "targets": [],
                "steps": [f"{sh(self.cfg.systemctl)} restart {sh(unit)}", "sleep 2"],
                "verify": [f"{sh(self.cfg.systemctl)} is-active {sh(unit)}"],
            }
        if name == "config.set":
            ok = CONFIG_ALLOW.get(a["key"])
            if not ok:
                raise Refuse("変えられるキー: " + " ".join(CONFIG_ALLOW), "bad_arg")
            if not ok(a["value"]):
                raise Refuse(f"{a['key']} にこの値は入れられない", "bad_arg")
            cur = self.inspector.hermes("cfgval", f"{a['profile']}:{a['key']}").get("value")
            if str(cur) == a["value"]:
                raise Refuse(f"もう {a['value']} になっている", "no_change")
            home = self.home_of(a["profile"])
            return {
                "title": f"部品 config.set: {a['profile']} / {a['key']}",
                "preview": f"{a['profile']} / {a['key']}\n  今: {cur}\n  変更後: {a['value']}",
                "targets": [os.path.join(home, "config.yaml")],
                "steps": [f"H {sh(home)} {sh(self.cfg.hermes_bin)} config set {sh(a['key'])} {sh(a['value'])}"],
                "verify": [f"H {sh(home)} {sh(self.cfg.hermes_bin)} config get {sh(a['key'])}"],
            }
        if name == "skill.sync":
            return self.plan_skill_sync(a["profile"], a["name"])
        if name == "undo":
            return self.plan_undo(a["id"])
        raise Refuse("知らない部品", "bad_action")

    def plan_skill_sync(self, profile, skill):
        """リポジトリのスキルで、入っているスキルを更新する。新しく入れない・元はリポジトリの版だけ"""
        import difflib

        src = os.path.join(self.cfg.repo_dir, "deploy", "hermes-skills", skill, "SKILL.md")
        try:
            new = open(src, encoding="utf-8").read()
        except OSError:
            raise Refuse(f"リポジトリにスキル {skill} は無い", "bad_arg")
        installed = self.inspector.hermes("skills", profile)[profile]
        rel = next((r for r in installed if r == skill or r.endswith("/" + skill)), None)
        if not rel:
            raise Refuse(f"{profile} に {skill} は入っていない", "bad_arg")
        path = os.path.join(self.home_of(profile), "skills", rel, "SKILL.md")
        cur = self.read_as_hermes(path)
        if cur is None:
            raise Refuse("今のスキルを読めない", "bad_state")
        if cur == new:
            raise Refuse("もう同じ内容", "no_change")
        diff = [mask_text(x) for x in difflib.unified_diff(cur.splitlines(), new.splitlines(), "今", "更新後", lineterm="")]
        extra = [f"（ほか {len(diff) - UNDO_PREVIEW_LINES} 行）"] if len(diff) > UNDO_PREVIEW_LINES else []
        return {
            "title": f"部品 skill.sync: {profile} / {skill}",
            "preview": "\n".join([f"--- {path}", *diff[:UNDO_PREVIEW_LINES], *extra]),
            "targets": [path],
            "steps": [f"restore {sh(src)} {sh(path)}"],
            "verify": [],
        }

    def read_as_hermes(self, path):
        code, out, _ = self.inspector._run([*self.cfg.as_hermes, "cat", "--", path])
        return out if code == 0 else None

    def plan_undo(self, rid):
        import difflib

        m = self.engine._load(rid)
        if m["status"] != "done":
            raise Refuse(f"元に戻せるのは、終わった（done）部品の依頼だけ（今は {m['status']}）", "not_undoable")
        if not any(f["name"] == "action.json" for f in m.get("files", [])):
            raise Refuse("部品の依頼ではない（自由なスクリプトは元に戻せない）", "not_undoable")
        bdir = os.path.join(self.backup_root, rid)
        try:
            index = [ln.split("\t", 1) for ln in open(os.path.join(bdir, "index"), encoding="utf-8").read().splitlines() if "\t" in ln]
        except OSError:
            raise Refuse("この依頼の控えが無い", "not_undoable")
        home = self.cfg.hermes_home.rstrip("/") + "/"
        preview, steps, targets = [f"{m['title']}（{rid}）を、実行の前の状態に戻す"], [], []
        for i, path in index:
            if not re.match(r"^[0-9]{1,3}$", i) or not path.startswith(home) or "/../" in path:
                raise Refuse("控えの記録の形が違う", "bad_state")
            try:
                before = open(os.path.join(bdir, i), encoding="utf-8", errors="replace").read()
            except OSError:
                raise Refuse("控えのファイルが無い", "bad_state")
            now_ = self.read_as_hermes(path)
            if now_ is None:
                raise Refuse(f"今のファイルを読めない: {path}", "bad_state")
            diff = list(difflib.unified_diff(now_.splitlines(), before.splitlines(), "今", "戻したあと", lineterm=""))
            if diff:
                preview.append(f"--- {path}")
                preview += [mask_text(x) for x in diff[:UNDO_PREVIEW_LINES]]
                if len(diff) > UNDO_PREVIEW_LINES:
                    preview.append(f"（ほか {len(diff) - UNDO_PREVIEW_LINES} 行）")
                targets.append(path)
                steps.append(f"restore {sh(os.path.join(bdir, i))} {sh(path)}")
        if not steps:
            raise Refuse("もう控えと同じ。戻すものが無い", "no_change")
        return {"title": f"部品 undo: {m['title'][:120]}", "preview": "\n".join(preview), "targets": targets, "steps": steps, "verify": []}

    def script(self, name, a, p):
        hhome = os.path.dirname(self.cfg.hermes_home.rstrip("/"))
        prefix = " ".join(sh(x) for x in self.cfg.as_hermes)
        lines = [
            "#!/bin/bash",
            f"# 部品 {name} {' '.join(a.values())}（plasmod-rootd が組み立てた。依頼者はこの中身を書けない）",
            "set -euo pipefail",
            "exec 2>&1",
            f'B={sh(self.backup_root)}/"$PLASMOD_ROOTD_REQUEST_ID"',
            'install -d -m 700 "$B"',
            ': > "$B/index"',
            "# Hermes のファイルの読み書きは hermes の権限で",
            f'H() {{ local home=$1; shift; {prefix} env -i HOME={sh(hhome)} PATH={hhome}/.local/bin:/usr/local/bin:/usr/bin:/bin LANG=C.UTF-8 HERMES_HOME="$home" "$@"; }}',
            "n=0",
            'backup() { n=$((n+1)); H / cat -- "$1" > "$B/$n"; printf \'%s\\t%s\\n\' "$n" "$1" >> "$B/index"; echo "控え: $1 -> $B/$n"; }',
            'restore() { H / tee -- "$2" < "$1" > /dev/null; echo "戻した: $2"; }',
            'show_diff() { while IFS=$\'\\t\' read -r i p; do echo "--- 差分: $p"; diff -u --label 前 --label 後 "$B/$i" <(H / cat -- "$p") || true; done < "$B/index"; }',
            *[f"backup {sh(t)}" for t in p["targets"]],
            *p["steps"],
            "show_diff",
        ]
        if p["verify"]:
            lines += ['echo "--- 確かめ"', *p["verify"]]
        return "\n".join(lines) + "\n"

    def submit(self, uid, uname, name, args, reason=""):
        a = self.check_args(name, args)
        p = self.plan(name, a)
        record = {"v": 1, "action": name, "args": a, "targets": p["targets"]}
        files = [
            {"name": "preview.txt", "data_b64": base64.b64encode(p["preview"].encode()).decode()},
            {"name": "action.json", "data_b64": base64.b64encode(json.dumps(record, ensure_ascii=False, indent=1).encode()).decode()},
        ]
        req = {
            "title": p["title"][:MAX_TITLE].replace("\n", " "),
            "reason": (reason or "")[: MAX_REASON - 200] + ("\n\n" if reason else "") + "決まった部品（スクリプトは plasmod-rootd が組み立てた）。下見は preview.txt",
            "timeout": ACTION_TIMEOUT,
            "script_b64": base64.b64encode(self.script(name, a, p).encode()).decode(),
            "files": files,
        }
        r = self.engine.submit(uid, uname, req)
        return {**r, "preview": p["preview"]}

    def run_for_owner(self, approver_uid, command, password, by):
        """アプリでオーナーが打ったコマンド: 依頼を作って、同じパスワードで承認する。
        受け口は承認の app.sock だけ（エージェントは使えない）。パスワードが違えば依頼は残さない"""
        if not isinstance(command, str) or not command.strip():
            raise Refuse("コマンドが空", "bad_arg")
        if len(command.encode()) > OWNER_COMMAND_MAX or "\0" in command:
            raise Refuse("コマンドが長すぎる", "bad_arg")
        first = command.strip().splitlines()[0]
        req = {
            "title": f"オーナーのコマンド: {first}"[:MAX_TITLE],
            "reason": f"アプリで打った（{str(by)[:40]}）",
            "timeout": ACTION_TIMEOUT,
            "script_b64": base64.b64encode(("#!/bin/bash\nexec 2>&1\n" + command.strip() + "\n").encode()).decode(),
            "files": [],
        }
        r = self.engine.submit(approver_uid, "app", req, notify=False)  # 本人がその場で承認するので知らせない
        try:
            return {**self.engine.approve(r["id"], r["digest"], password, by), "id": r["id"]}
        except Refuse:
            self.engine.reject(r["id"], by)
            raise

    def undo_for_app(self, approver_uid, rid, password, by):
        """アプリの「元に戻す」: 依頼を作って、同じパスワードで承認する（パスワードの照合は approve と同じ）"""
        if not isinstance(rid, str) or not ID_RE.match(rid):
            raise Refuse("ID の形が違う", "bad_id")
        r = self.submit(approver_uid, "app", "undo", [rid], f"アプリの「元に戻す」（{str(by)[:40]}）")
        return {**self.engine.approve(r["id"], r["digest"], password, by), "preview": r["preview"]}


# ---------------------------------------------------------------- ソケット

SO_PEERCRED = getattr(socket, "SO_PEERCRED", 17)


def peer_uid(conn):
    pid, uid, gid = struct.unpack("3i", conn.getsockopt(socket.SOL_SOCKET, SO_PEERCRED, struct.calcsize("3i")))
    return uid


def uid_name(uid):
    try:
        return pwd.getpwuid(uid).pw_name
    except KeyError:
        return str(uid)


class Handlers:
    """op ごとの処理。role: 'req' か 'app'"""

    def __init__(self, engine: Engine, requester_uids, approver_uids, inspector=None):
        self.engine = engine
        self.requester_uids = requester_uids
        self.approver_uids = approver_uids
        self.inspector = inspector or Inspector(engine.cfg)
        self.actions = Actions(engine.cfg, engine, self.inspector)

    def handle(self, role, uid, req):
        allowed = self.requester_uids() if role == "req" else self.approver_uids()
        if uid not in allowed:
            self.engine.audit("denied", role=role, uid=uid)
            return {"ok": False, "code": "forbidden", "error": "この受け口は使えない"}
        op = req.get("op")
        try:
            if role == "req":
                if op == "submit":
                    return {"ok": True, **self.engine.submit(uid, uid_name(uid), req)}
                if op == "status":
                    return {"ok": True, **self.engine.status_for_requester(uid, req.get("id"))}
                if op == "inspect":
                    item, arg = req.get("item"), req.get("arg")
                    self.engine.audit("inspect", uid=uid, requester=uid_name(uid), item=str(item)[:40], arg=str(arg)[:80] if arg is not None else None)
                    return {"ok": True, "item": item, "data": self.inspector.run(item, arg)}
                if op == "action":
                    return {"ok": True, **self.actions.submit(uid, uid_name(uid), req.get("name"), req.get("args"), req.get("reason") if isinstance(req.get("reason"), str) else "")}
            else:
                if op == "list":
                    return {"ok": True, **self.engine.list_for_app()}
                if op == "get":
                    return {"ok": True, **self.engine.get_for_app(req.get("id"))}
                if op == "reject":
                    return {"ok": True, **self.engine.reject(req.get("id"), str(req.get("by", "")))}
                if op == "run":
                    return {"ok": True, **self.actions.run_for_owner(uid, req.get("command"), req.get("password"), str(req.get("by", "")))}
                if op == "undo":
                    return {"ok": True, **self.actions.undo_for_app(uid, req.get("id"), req.get("password"), str(req.get("by", "")))}
                if op == "approve":
                    return {"ok": True, **self.engine.approve(req.get("id"), req.get("digest"), req.get("password"), str(req.get("by", "")))}
            return {"ok": False, "code": "bad_op", "error": "知らない操作"}
        except Refuse as e:
            return {"ok": False, "code": e.code, "error": str(e), **e.extra}


def make_server(path, role, handlers, group_gid=None, mode=0o666):
    class H(socketserver.StreamRequestHandler):
        timeout = 30

        def handle(self):
            try:
                uid = peer_uid(self.request)
                line = self.rfile.readline(MAX_LINE + 1)
                if len(line) > MAX_LINE:
                    resp = {"ok": False, "code": "too_large", "error": "大きすぎる"}
                else:
                    try:
                        req = json.loads(line)
                        if not isinstance(req, dict):
                            raise ValueError
                    except ValueError:
                        resp = {"ok": False, "code": "bad_json", "error": "JSON が読めない"}
                    else:
                        resp = handlers.handle(role, uid, req)
                self.wfile.write(json.dumps(resp, ensure_ascii=False).encode() + b"\n")
            except (OSError, socket.timeout):
                pass
            except Exception as e:  # noqa: BLE001 内容は出さず、型だけ
                print(f"handler error: {type(e).__name__}", file=sys.stderr)

    class S(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
        daemon_threads = True
        request_queue_size = 32

    try:
        os.unlink(path)
    except FileNotFoundError:
        pass
    old = os.umask(0o177)
    try:
        srv = S(path, H)
    finally:
        os.umask(old)
    if group_gid is not None:
        os.chown(path, 0 if os.geteuid() == 0 else -1, group_gid)
    os.chmod(path, mode)
    return srv


def serve(cfg: Config):
    cfg.validate()
    os.makedirs(cfg.run_dir, mode=0o755, exist_ok=True)
    engine = Engine(cfg)  # 起動時に recover（実行中だったものを中断にする）
    handlers = Handlers(engine, cfg.requester_uids, cfg.approver_uids)
    gid = None
    try:
        gid = pwd.getpwnam(cfg.approver).pw_gid
    except KeyError:
        pass
    req = make_server(os.path.join(cfg.run_dir, "req.sock"), "req", handlers, None, 0o666)
    app = make_server(os.path.join(cfg.run_dir, "app.sock"), "app", handlers, gid, 0o660 if gid is not None else 0o600)
    for s in (req, app):
        threading.Thread(target=s.serve_forever, daemon=True).start()
    stop = threading.Event()
    for sig in (signal.SIGTERM, signal.SIGINT):
        signal.signal(sig, lambda *_: stop.set())
    print("plasmod-rootd: ready", file=sys.stderr, flush=True)
    stop.wait()
    req.shutdown()
    app.shutdown()


def set_password(cfg: Config):
    if os.geteuid() != 0:
        raise SystemExit("root で実行すること")
    if not sys.stdin.isatty():
        raise SystemExit("端末から対話で実行すること（パイプや引数でパスワードを渡さない）")
    p1 = getpass.getpass("新しいパスワード（%d 文字以上、表示されない）: " % MIN_PASSWORD_LEN)
    if len(p1) < MIN_PASSWORD_LEN or len(p1) > MAX_PASSWORD_LEN:
        raise SystemExit("短すぎる")
    p2 = getpass.getpass("もう一度: ")
    if p1 != p2:
        raise SystemExit("一致しない")
    write_password_file(cfg.passwd_file, p1)
    try:
        os.unlink(os.path.join(cfg.state_dir, "lock.json"))
    except OSError:
        pass
    print("パスワードを設定した（%s）。ロックも解除した。" % cfg.passwd_file)


def main(argv):
    cfg = Config.load(os.environ.get("PLASMOD_ROOTD_CONFIG", "/etc/plasmod-rootd/config"))
    cmd = argv[1] if len(argv) > 1 else ""
    if cmd == "serve":
        serve(cfg)
    elif cmd == "set-password":
        set_password(cfg)
    elif cmd == "list":
        engine = Engine(cfg, recover=False)  # 動いている plasmod-rootd の状態を壊さない
        for r in engine.list_for_app()["requests"][:30]:
            print(r["id"], r["status"], r.get("requester", ""), r["title"])
    else:
        print("usage: plasmod-rootd serve | set-password | list", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
