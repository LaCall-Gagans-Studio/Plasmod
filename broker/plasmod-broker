CONF_FILE = "/etc/plasmod-broker.conf"   # 任意。root が置く。HERMES_USER_HOME=・HERMES_HOME=・HERMES_BIN=・DEV_ASSIGNEE=


def conf(key, default):
    try:
        with open(CONF_FILE, encoding="utf-8") as f:
            for line in f:
                k, sep, v = line.strip().partition("=")
                if sep and k == key and v:
                    return v
    except OSError:
        pass
    return default


