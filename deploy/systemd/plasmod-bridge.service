[Unit]
Description=Plasmod bridge: app sessions <-> Claude Code sessions
After=network-online.target

[Service]
# Claude Code を動かすユーザー。アプリとは別のユーザーにする（自分の依頼を承認できないように）
User=dev
Environment=HOME=/home/dev
Environment=PATH=/home/dev/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/home/dev/work
ExecStart=/usr/bin/python3 /usr/local/lib/plasmod-bridge/plasmod_bridge.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
