def deliver_kind(v):
    """送り先は種類（local・origin など）だけ。チャンネルやチャットの ID は出さない"""
    items = v if isinstance(v, list) else [v] if v else []
    return [str(x).split(":", 1)[0][:20] for x in items if isinstance(x, str) and x][:5]


def cron_jobs(home):
    try:
        with open(os.path.join(home, "cron", "jobs.json"), encoding="utf-8") as f:
            data = json.load(f)
    except FileNotFoundError:
        return []
    except (OSError, ValueError) as e:
        return {"error": f"jobs.json を読めない: {e.__class__.__name__}"}
    jobs = data.get("jobs", []) if isinstance(data, dict) else data
    if not isinstance(jobs, list):
        jobs = []
    def text(v, n):
        return v[:n] if isinstance(v, str) and v else None

    out = []
    for j in jobs[:200]:
        if not isinstance(j, dict):
            continue
        sched = j.get("schedule") if isinstance(j.get("schedule"), dict) else {}
        repeat = j.get("repeat") if isinstance(j.get("repeat"), dict) else {}
        skills = j.get("skills") if isinstance(j.get("skills"), list) else [j["skill"]] if isinstance(j.get("skill"), str) else []
        enabled = j.get("enabled", True) is not False
        state = text(j.get("state"), 20) or "scheduled"
        if not enabled and state not in ("completed", "error"):
            state = "paused"
        out.append({
            "id": text(j.get("id"), 40),
            "name": text(j.get("name"), 200),
            "schedule": text(j.get("schedule_display") or sched.get("display") or sched.get("expr"), 100),
            "kind": text(sched.get("kind"), 20),
            "enabled": enabled,
            "state": state,
            "paused_reason": text(j.get("paused_reason"), 300),
            "next_run_at": text(j.get("next_run_at"), 40),
            "last_run_at": text(j.get("last_run_at"), 40),
            "last_status": text(j.get("last_status"), 40),
            "last_error": text(j.get("last_error"), 500),
            "last_delivery_error": text(j.get("last_delivery_error"), 300),
            "failure_streak": j.get("failure_streak") if isinstance(j.get("failure_streak"), int) else 0,
            "repeat": {"times": repeat.get("times") if isinstance(repeat.get("times"), int) else None,
                       "completed": repeat.get("completed") if isinstance(repeat.get("completed"), int) else 0},
            "skills": [text(x, 80) for x in skills if isinstance(x, str)][:20],
            "model": text(j.get("model"), 100),
            "script": bool(j.get("script")),
            "no_agent": bool(j.get("no_agent")),
            "deliver": deliver_kind(j.get("deliver")),
            "prompt": text(j.get("prompt"), 4000),
        })
    return out


CRON_OUTPUT_MAX = 8
RESPONSE_HEADING = "\n## Response\n\n"


def cron_output(profile):
    home = profiles().get(profile)
    if not home:
        die("知らないプロファイル")
    names = {}
    jobs = cron_jobs(home)
    if isinstance(jobs, list):
        names = {j["id"]: j["name"] for j in jobs if j.get("id")}
    odir = os.path.join(home, "cron", "output")
    found = []
    if os.path.isdir(odir):
        for job in os.listdir(odir):
            jdir = os.path.join(odir, job)
            if not re.match(r"^[A-Za-z0-9_-]{1,64}$", job) or os.path.islink(jdir) or not os.path.isdir(jdir):
                continue
            for name in os.listdir(jdir):
                path = os.path.join(jdir, name)
                if name.endswith(".md") and not name.startswith(".") and os.path.isfile(path) and not os.path.islink(path):
                    found.append((os.path.getmtime(path), job, path))
    out = []
    for mtime, job, path in sorted(found, reverse=True)[:CRON_OUTPUT_MAX]:
        text = read_text(path, 256 * 1024) or ""
        head = text.split("\n", 1)[0]
        i = text.rfind(RESPONSE_HEADING)
        body = text[i + len(RESPONSE_HEADING):] if i >= 0 else text
        out.append({"job": job, "name": names.get(job) or job, "at": int(mtime), "ok": "(FAILED)" not in head,
                    "text": body.strip()[:30000]})
    print(json.dumps(out, ensure_ascii=False))


