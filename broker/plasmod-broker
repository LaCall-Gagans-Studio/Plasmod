def die(msg, code=2):
    print(f"plasmod-broker: {msg}", file=sys.stderr)
    sys.exit(code)


def task_id(s):
    if not s or len(s) > 64 or not all(c.isalnum() or c in "-_" for c in s):
        die(f"不正なカードID: {s!r}")
    return s


def kanban(*args):
    r = subprocess.run([HERMES, "kanban", *args], env=ENV, cwd=USER_HOME, capture_output=True, text=True)
    if r.returncode != 0:
        die((r.stderr or r.stdout).strip()[-2000:] or f"hermes kanban {args[0]} failed", r.returncode)
    print(r.stdout, end="")


def db():
    c = sqlite3.connect(f"file:{KANBAN_DB}?mode=ro", uri=True, timeout=5)
    c.row_factory = sqlite3.Row
    return c


TASK_COLS = ("id, title, body, assignee, status, priority, created_by, created_at, started_at, completed_at, "
             "last_heartbeat_at, block_kind, result")


def board():
    c = db()
    try:
        since = int(time.time()) - DONE_WINDOW
        tasks = [dict(r) for r in c.execute(
            f"SELECT {TASK_COLS} FROM tasks WHERE status != 'archived' AND (status != 'done' OR completed_at >= ?)",
            (since,))]
        ids = [t["id"] for t in tasks]
        latest = {}
        if ids:
            q = ",".join("?" * len(ids))
            for r in c.execute(
                    f"""SELECT task_id, author, body, created_at FROM task_comments c
                        WHERE task_id IN ({q}) AND id = (SELECT MAX(id) FROM task_comments WHERE task_id = c.task_id)""",
                    ids):
                latest[r["task_id"]] = {"author": r["author"], "body": (r["body"] or "")[:4000], "created_at": r["created_at"]}
        for t in tasks:
            t["body"] = (t["body"] or "")[:4000] or None
            t["result"] = (t["result"] or "")[:2000] or None
            t["latest_comment"] = latest.get(t["id"])
        idset = set(ids)
        links = [dict(r) for r in c.execute("SELECT parent_id, child_id FROM task_links")
                 if r["parent_id"] in idset or r["child_id"] in idset]
        runs = [dict(r) for r in c.execute(
            "SELECT task_id, profile, started_at, last_heartbeat_at FROM task_runs WHERE status = 'running' AND ended_at IS NULL")]
        latest_event = c.execute("SELECT COALESCE(MAX(id), 0) FROM task_events").fetchone()[0]
        print(json.dumps({"latest_event_id": latest_event, "tasks": tasks, "links": links, "active_runs": runs},
                         ensure_ascii=False))
    finally:
        c.close()


