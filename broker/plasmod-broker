def hermes_cfg(profile, *args):
    cmd = [HERMES] + (["-p", profile] if profile != "default" else []) + ["config", *args]
    try:
        r = subprocess.run(cmd, env=ENV, cwd=USER_HOME, capture_output=True, text=True, timeout=20)
    except subprocess.TimeoutExpired:
        die("hermes config が 20 秒で終わらなかった")
    if r.returncode != 0:
        die((r.stderr or r.stdout).strip()[-1000:] or "hermes config failed", r.returncode)
    return r.stdout.strip()


def model_choices():
    try:
        with open(MODELS_FILE) as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def model_of(name, home):
    """いまのモデル。config.yaml を直接読む（hermes config get を毎回起動すると1回数秒かかり、
    プロファイル8つ×2回で1分を超えて、システムの画面が読み込みのまま終わらなかった）。書いていなければ hermes に聞く"""
    try:
        import yaml
        with open(os.path.join(home, "config.yaml"), encoding="utf-8") as f:
            m = (yaml.safe_load(f) or {}).get("model")
        if isinstance(m, dict) and m.get("default"):
            return {"provider": str(m["provider"]) if m.get("provider") else None, "model": str(m["default"])}
        if isinstance(m, str) and m:
            return {"provider": None, "model": m}
    except Exception:  # 読めない・形が違う・yaml が無い → hermes に聞く
        pass
    try:
        return {"provider": hermes_cfg(name, "get", "model.provider"), "model": hermes_cfg(name, "get", "model.default")}
    except SystemExit:
        return {"provider": None, "model": None}


def models():
