#!/usr/bin/env python3
"""plasmod-rootd: root の作業を「オーナーがアプリでパスワードを入れて承認したときだけ」実行する常駐サービス。

  依頼の受け口  /run/plasmod-rootd/req.sock  uid が requesters（cc・hermes）のものだけ。submit / status / inspect（読むだけの決まった項目、承認なし）/ action（決まった部品）
  承認の受け口  /run/plasmod-rootd/app.sock   uid が approver（plasmod）のものだけ。list / get / approve / reject / info / undo（部品を元に戻す。依頼と承認を 1 回で）
  どちらも SO_PEERCRED で相手の uid を確かめる（名前でなく、カーネルが保証する uid）。

守っていること:
  - 依頼の中身（スクリプト全文と添付）は受け取った時点で root 所有の場所（state/requests/ID/）にコピーし、
    title・reason・timeout・スクリプトと添付の SHA-256 を束ねた digest を取る。実行するのはそのコピーだけ。
  - 承認は「ID + digest + パスワード」。digest が合わなければ（＝見せた内容と違えば）承認しない。
  - パスワードは root だけが読める scrypt のハッシュで保存し、照合はここ（root）でやる。ログにも出さない。
  - 5 回間違えたら 15 分ロック。依頼は 24 時間で失効。1 依頼は 1 回しか実行しない（再起動をまたいでも）。
  - 実行はタイムアウトつき。出力は上限つきで root 所有のログ（/var/log/plasmod-rootd/）に残す。
"""
import base64
import getpass
import hashlib
import hmac
import json
import os
import pwd
import re
import secrets
import signal
import shutil
import socket
import socketserver
import struct
import subprocess
import sys
import threading
import time
import urllib.request

MAX_LINE = 40 * 1024 * 1024  # 1 リクエスト（JSON 1 行）の上限
MAX_SCRIPT = 512 * 1024
MAX_FILES = 20
MAX_FILES_TOTAL = 16 * 1024 * 1024
MAX_TITLE = 200
MAX_REASON = 4000
MAX_PENDING_PER_UID = 10
PREVIEW_BYTES = 64 * 1024
TTL_SECONDS = 24 * 3600
LOCK_AFTER = 5
LOCK_SECONDS = 15 * 60
DEFAULT_TIMEOUT = 600
MAX_TIMEOUT = 3600
OUTPUT_CAP = 256 * 1024  # stdout / stderr それぞれ
MIN_PASSWORD_LEN = 12
MAX_PASSWORD_LEN = 1024
SCRYPT_N, SCRYPT_R, SCRYPT_P = 2**15, 8, 1

ID_RE = re.compile(r"^[0-9]{14}-[0-9a-f]{6}$")
DIGEST_RE = re.compile(r"^[0-9a-f]{64}$")
FILENAME_RE = re.compile(r"^[A-Za-z0-9._+-][A-Za-z0-9._ +-]{0,127}$")
TERMINAL = {"done", "failed", "timeout", "rejected", "expired", "interrupted"}


class Refuse(Exception):
    """利用者に返してよいエラー（メッセージにパスワード・内部パスを入れない）"""

    def __init__(self, msg, code="refused", **extra):
        super().__init__(msg)
        self.code = code
        self.extra = extra


def now() -> float:
    return time.time()


def write_atomic(path: str, data: bytes, mode: int = 0o600):
    tmp = f"{path}.tmp-{secrets.token_hex(4)}"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


# ---------------------------------------------------------------- パスワード

def hash_password(password: str, n=SCRYPT_N, r=SCRYPT_R, p=SCRYPT_P) -> str:
    salt = secrets.token_bytes(16)
    dk = hashlib.scrypt(password.encode(), salt=salt, n=n, r=r, p=p, maxmem=256 * 1024 * 1024, dklen=32)
    b = lambda x: base64.b64encode(x).decode()
    return f"scrypt${n}${r}${p}${b(salt)}${b(dk)}"


def check_password(stored: str, password: str) -> bool:
    try:
        scheme, n, r, p, salt, dk = stored.strip().split("$")
        if scheme != "scrypt":
            return False
        want = base64.b64decode(dk)
        got = hashlib.scrypt(
            password.encode(), salt=base64.b64decode(salt), n=int(n), r=int(r), p=int(p), maxmem=256 * 1024 * 1024, dklen=len(want)
        )
    except (ValueError, TypeError):
        return False
    return hmac.compare_digest(got, want)


def write_password_file(path: str, password: str, **params):
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    write_atomic(path, (hash_password(password, **params) + "\n").encode(), 0o600)


# ---------------------------------------------------------------- 設定

class Config:
    def __init__(self, **kw):
        self.state_dir = "/var/lib/plasmod-rootd"
        self.log_dir = "/var/log/plasmod-rootd"
        self.run_dir = "/run/plasmod-rootd"
        self.passwd_file = "/etc/plasmod-rootd/passwd"
        self.app_env = "/etc/plasmod/env"  # 通知の宛先を読む（root だけが読める）
        self.requesters = ["cc", "hermes"]
        self.approver = "plasmod"
        self.shell = "/bin/bash"
        # inspect（読むだけ）: Hermes のファイルは hermes の権限で読む（root で辿らない）
        self.hermes_home = "/home/hermes/.hermes"
        self.unit_prefixes = list(UNIT_PREFIXES)  # 設定の UNIT_PREFIXES で足せる
        self.repo_dir = "/opt/plasmod"  # skill.sync の元（root 所有のコード）
        self.hermes_python = "/usr/bin/python3"
        self.hermes_bin = "/home/hermes/.local/bin/hermes"
        self.as_hermes = ["/usr/sbin/runuser", "-u", "hermes", "--"]  # 絶対パス: hermes に渡す PATH には sbin が無く、そこから探される
        self.systemctl = "systemctl"
        self.journalctl = "journalctl"
        self.__dict__.update(kw)

    @classmethod
    def load(cls, path="/etc/plasmod-rootd/config"):
        cfg = cls()
        try:
            lines = open(path).read().splitlines()
        except OSError:
            return cfg
        for line in lines:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            k, v = k.strip(), v.strip()
            if k == "REQUESTERS":
                cfg.requesters = [x for x in v.replace(",", " ").split() if x]
            elif k == "UNIT_PREFIXES":
                cfg.unit_prefixes = list(UNIT_PREFIXES) + [x for x in v.replace(",", " ").split() if x]
            elif k == "APPROVER":
                cfg.approver = v
            elif k == "HERMES_USER":
                cfg.as_hermes = ["/usr/sbin/runuser", "-u", v, "--"]
            elif k == "HERMES_HOME":
                cfg.hermes_home = v
            elif k == "HERMES_BIN":
                cfg.hermes_bin = v
        return cfg

    def uid_of(self, name):
        try:
            return pwd.getpwnam(name).pw_uid
        except KeyError:
            return None

    def requester_uids(self):
        return {u for u in (self.uid_of(n) for n in self.requesters) if u is not None}

    def approver_uids(self):
        u = self.uid_of(self.approver)
        return {u} if u is not None else set()

    def validate(self):
        """起動時の確認: 依頼する側と承認する側が同じユーザーなら、承認の意味がなくなるので起動しない"""
        if self.approver_uids() & self.requester_uids():
            raise SystemExit("approver が requesters に含まれている。承認と依頼は別のユーザーにすること")
        if not self.approver_uids():
            print(f"warning: approver ユーザー {self.approver} が無い。承認の受け口は誰も使えない", file=sys.stderr)


# ---------------------------------------------------------------- 通知

def read_env_file(path):
    out = {}
    try:
        for line in open(path).read().splitlines():
            if "=" in line and not line.lstrip().startswith("#"):
                k, v = line.split("=", 1)
                out[k.strip()] = v.strip().strip("'\"")
    except OSError:
        pass
    return out


class Notifier:
    def __init__(self, env_path):
        self.env_path = env_path

    def send(self, title, message, priority=4, tags=("lock",), click_path="/#/root"):
        """通知にボタンは付けない（承認はアプリを開かせる）。失敗しても本体の処理は止めない"""
        env = read_env_file(self.env_path)
        url = env.get("PLASMOD_NOTIFY_URL", "").rstrip("/")
        if not url:
            return
        body = {"title": title, "message": message, "priority": priority, "tags": list(tags)}
        if env.get("PLASMOD_PUBLIC_URL"):
            body["click"] = env["PLASMOD_PUBLIC_URL"].rstrip("/") + click_path
        headers = {"Content-Type": "application/json"}
        if env.get("PLASMOD_NOTIFY_TOKEN"):
            headers["Authorization"] = "Bearer " + env["PLASMOD_NOTIFY_TOKEN"]
        try:
            req = urllib.request.Request(url, data=json.dumps(body).encode(), headers=headers, method="POST")
            urllib.request.urlopen(req, timeout=10).read()
        except Exception as e:  # noqa: BLE001 通知の失敗は握りつぶしてログだけ
            print(f"通知の失敗: {type(e).__name__}", file=sys.stderr)


# ---------------------------------------------------------------- 本体

def manifest_digest(title, reason, timeout, script_sha, files):
    m = {
        "v": 1,
        "title": title,
        "reason": reason,
        "timeout": timeout,
        "script_sha256": script_sha,
        "files": sorted(({"name": f["name"], "sha256": f["sha256"], "size": f["size"]} for f in files), key=lambda f: f["name"]),
    }
    return hashlib.sha256(json.dumps(m, sort_keys=True, separators=(",", ":"), ensure_ascii=True).encode()).hexdigest()


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


class Engine:
    """依頼の保存・状態遷移・実行。状態の変更は全部 self.lock の中で行う。"""

    def __init__(self, cfg: Config, notifier=None, clock=now, recover=True):
        self.cfg = cfg
        self.notifier = notifier or Notifier(cfg.app_env)
        self.clock = clock
        self.lock = threading.RLock()
        self.exec_lock = threading.Lock()  # 実行は 1 つずつ
        self.req_dir = os.path.join(cfg.state_dir, "requests")
        self.lock_file = os.path.join(cfg.state_dir, "lock.json")
        os.makedirs(self.req_dir, mode=0o700, exist_ok=True)
        os.makedirs(cfg.log_dir, mode=0o700, exist_ok=True)
        os.chmod(cfg.state_dir, 0o700)
        self.threads = []
        if recover:
            self.recover()

    # ---- 保存 ----
    def _dir(self, rid):
        if not isinstance(rid, str) or not ID_RE.match(rid):
            raise Refuse("ID の形が違う", "bad_id")
        return os.path.join(self.req_dir, rid)

    def _load(self, rid):
        path = os.path.join(self._dir(rid), "meta.json")
        try:
            with open(path) as f:
                meta = json.load(f)
        except OSError:
            raise Refuse("その依頼は無い", "not_found")
        if meta["status"] == "pending" and self.clock() > meta["expires_at"]:
            meta["status"] = "expired"
            meta["finished_at"] = meta["expires_at"]
            self._save(meta)
            self.audit("expired", id=rid)
        return meta

    def _save(self, meta):
        write_atomic(os.path.join(self._dir(meta["id"]), "meta.json"), json.dumps(meta, ensure_ascii=False).encode())

    def audit(self, event, **kw):
        line = json.dumps({"t": int(self.clock()), "event": event, **kw}, ensure_ascii=False)
        try:
            fd = os.open(os.path.join(self.cfg.log_dir, "audit.log"), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
            with os.fdopen(fd, "a") as f:
                f.write(line + "\n")
        except OSError:
            pass
        print(line, file=sys.stderr, flush=True)

    def all_ids(self):
        return sorted((d for d in os.listdir(self.req_dir) if ID_RE.match(d)), reverse=True)

    def recover(self):
        """再起動で止まった実行は「中断」にする。自動では再実行しない（1 依頼 1 回）"""
        with self.lock:
            for rid in self.all_ids():
                try:
                    meta = self._load(rid)
                except Refuse:
                    continue
                if meta["status"] in ("approved", "running"):
                    meta["status"] = "interrupted"
                    meta["finished_at"] = self.clock()
                    meta["error"] = "plasmod-rootd が再起動したため中断（実行されたかもしれない。再実行はしない）"
                    self._save(meta)
                    self.audit("interrupted", id=rid)

    # ---- 依頼 ----
    def submit(self, uid, name, req, notify=True):
        title = req.get("title")
        reason = req.get("reason", "")
        if not isinstance(title, str) or not title.strip() or len(title) > MAX_TITLE or "\n" in title:
            raise Refuse("title は 1 行で 1〜200 文字")
        if not isinstance(reason, str) or len(reason) > MAX_REASON:
            raise Refuse("reason は 4000 文字まで")
        timeout = req.get("timeout", DEFAULT_TIMEOUT)
        if not isinstance(timeout, int) or isinstance(timeout, bool) or not 1 <= timeout <= MAX_TIMEOUT:
            raise Refuse(f"timeout は 1〜{MAX_TIMEOUT} 秒")
        try:
            script = base64.b64decode(req.get("script_b64", ""), validate=True)
        except (ValueError, TypeError):
            raise Refuse("script_b64 が読めない")
        if not script.strip() or len(script) > MAX_SCRIPT or b"\x00" in script:
            raise Refuse("スクリプトが空か、大きすぎる（512KiB まで）か、バイナリ")
        files_in = req.get("files", [])
        if not isinstance(files_in, list) or len(files_in) > MAX_FILES:
            raise Refuse(f"添付は {MAX_FILES} 個まで")
        files, seen, total = [], set(), 0
        for f in files_in:
            if not isinstance(f, dict) or not isinstance(f.get("name"), str) or not FILENAME_RE.match(f["name"]) or f["name"] in (".", ".."):
                raise Refuse("添付のファイル名が不正（英数字と ._+- と空白、128 文字まで。ディレクトリ不可）")
            if f["name"] in seen:
                raise Refuse("添付のファイル名が重複している")
            seen.add(f["name"])
            try:
                data = base64.b64decode(f.get("data_b64", ""), validate=True)
            except (ValueError, TypeError):
                raise Refuse("添付が読めない")
            total += len(data)
            if total > MAX_FILES_TOTAL:
                raise Refuse("添付が大きすぎる（合計 16MiB まで）")
            files.append({"name": f["name"], "data": data, "sha256": hashlib.sha256(data).hexdigest(), "size": len(data)})

        with self.lock:
            pending = 0
            for rid in self.all_ids():
                try:
                    m = self._load(rid)
                except Refuse:
                    continue
                if m["status"] == "pending" and m["requester_uid"] == uid:
                    pending += 1
            if pending >= MAX_PENDING_PER_UID:
                raise Refuse(f"承認待ちが {MAX_PENDING_PER_UID} 件たまっている。先に片づけてもらうこと", "too_many")
            t = self.clock()
            rid = time.strftime("%Y%m%d%H%M%S", time.gmtime(t)) + "-" + secrets.token_hex(3)
            while os.path.exists(os.path.join(self.req_dir, rid)):
                rid = time.strftime("%Y%m%d%H%M%S", time.gmtime(t)) + "-" + secrets.token_hex(3)
            d = os.path.join(self.req_dir, rid)
            os.mkdir(d, 0o700)
            os.mkdir(os.path.join(d, "files"), 0o700)
            sp = os.path.join(d, "script.sh")
            fd = os.open(sp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o400)
            with os.fdopen(fd, "wb") as fh:
                fh.write(script)
            for f in files:
                fd = os.open(os.path.join(d, "files", f["name"]), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o400)
                with os.fdopen(fd, "wb") as fh:
                    fh.write(f["data"])
            script_sha = hashlib.sha256(script).hexdigest()
            fmeta = [{"name": f["name"], "sha256": f["sha256"], "size": f["size"]} for f in files]
            meta = {
                "id": rid,
                "title": title,
                "reason": reason,
                "timeout": timeout,
                "requester_uid": uid,
                "requester": name,
                "created_at": t,
                "expires_at": t + TTL_SECONDS,
                "status": "pending",
                "script_sha256": script_sha,
                "script_size": len(script),
                "files": fmeta,
                "digest": manifest_digest(title, reason, timeout, script_sha, fmeta),
            }
            self._save(meta)
            self.audit("submit", id=rid, uid=uid, requester=name, digest=meta["digest"])
        # 通知には内容を出さない（依頼者が書いた文字列なので）。承認はアプリを開かせる
        if notify:
            self.notifier.send("承認待ち", "root 作業の承認待ちがあります。アプリで確認してください", 4, ("lock",))
        return {"id": rid, "digest": meta["digest"], "expires_at": meta["expires_at"]}

    # ---- 見せる ----
    def _summary(self, m):
        keys = ("id", "title", "status", "requester", "created_at", "expires_at", "started_at", "finished_at", "exit_code", "digest")
        return {k: m[k] for k in keys if k in m}

    def _result(self, m):
        out = {k: m.get(k) for k in ("exit_code", "duration", "error", "stdout", "stderr", "stdout_truncated", "stderr_truncated")}
        return {k: v for k, v in out.items() if v is not None}

    def status_for_requester(self, uid, rid):
        with self.lock:
            m = self._load(rid)
            if m["requester_uid"] != uid:  # 他の依頼者の依頼は存在も教えない
                raise Refuse("その依頼は無い", "not_found")
            return {**self._summary(m), **self._result(m)}

    def list_for_app(self):
        with self.lock:
            res = []
            for rid in self.all_ids()[:200]:
                try:
                    res.append(self._summary(self._load(rid)))
                except Refuse:
                    pass
            return {"requests": res, "lock": self.lock_info()}

    def get_for_app(self, rid):
        with self.lock:
            m = self._load(rid)
            d = self._dir(rid)
            with open(os.path.join(d, "script.sh"), "rb") as f:
                script = f.read()
            files = []
            for fm in m["files"]:
                with open(os.path.join(d, "files", fm["name"]), "rb") as f:
                    raw = f.read(PREVIEW_BYTES + 1)
                try:
                    preview = raw[:PREVIEW_BYTES].decode("utf-8") if b"\x00" not in raw else None
                except UnicodeDecodeError:
                    preview = None
                files.append({**fm, "preview": preview, "preview_truncated": len(raw) > PREVIEW_BYTES})
            return {
                **self._summary(m),
                "reason": m["reason"],
                "timeout": m["timeout"],
                "requester_uid": m["requester_uid"],
                "script": script.decode("utf-8", "replace"),
                "script_sha256": m["script_sha256"],
                "files": files,
                **self._result(m),
            }

    # ---- 承認・却下 ----
    def lock_info(self):
        try:
            with open(self.lock_file) as f:
                s = json.load(f)
        except (OSError, ValueError):
            s = {"failures": 0, "locked_until": 0}
        if s["locked_until"] and self.clock() >= s["locked_until"]:
            s = {"failures": 0, "locked_until": 0}
        return {"failures": s["failures"], "locked_until": s["locked_until"], "max_failures": LOCK_AFTER}

    def _set_lock(self, s):
        write_atomic(self.lock_file, json.dumps(s).encode())

    def reject(self, rid, by):
        with self.lock:
            m = self._load(rid)
            if m["status"] != "pending":
                raise Refuse(f"もう {m['status']} になっている", "not_pending")
            m["status"] = "rejected"
            m["finished_at"] = self.clock()
            m["decided_by"] = by
            self._save(m)
            self.audit("reject", id=rid, by=by)
            return self._summary(m)

    def approve(self, rid, digest, password, by):
        with self.lock:
            m = self._load(rid)
            if m["status"] != "pending":
                raise Refuse(f"もう {m['status']} になっている", "not_pending")
            if not isinstance(digest, str) or not DIGEST_RE.match(digest) or not hmac.compare_digest(digest, m["digest"]):
                # 画面に出した内容と違う。パスワードは見ない（失敗回数にも数えない）
                raise Refuse("承認する内容が、依頼の内容（digest）と合わない。画面を開き直すこと", "digest_mismatch")
            lk = self.lock_info()
            if lk["locked_until"]:
                raise Refuse("パスワードを間違えすぎたため、ロック中", "locked", locked_until=lk["locked_until"])
            if not isinstance(password, str) or not password or len(password) > MAX_PASSWORD_LEN:
                raise Refuse("パスワードを入れること", "bad_password_input")
            try:
                with open(self.cfg.passwd_file) as f:
                    stored = f.read()
            except OSError:
                raise Refuse("パスワードが未設定（plasmod-rootd set-password）", "no_password")
            if not check_password(stored, password):
                failures = lk["failures"] + 1
                if failures >= LOCK_AFTER:
                    until = self.clock() + LOCK_SECONDS
                    self._set_lock({"failures": 0, "locked_until": until})
                    self.audit("password_locked", id=rid, by=by, until=int(until))
                    self.notifier.send("パスワードを5回間違えた", "15分ロックしました。心当たりがなければ要確認です", 5, ("rotating_light",))
                    raise Refuse("パスワードが違う。5 回間違えたので 15 分ロックした", "locked", locked_until=until)
                self._set_lock({"failures": failures, "locked_until": 0})
                self.audit("password_failed", id=rid, by=by, failures=failures)
                self.notifier.send("パスワードの入力に失敗", f"{failures}/{LOCK_AFTER} 回目。心当たりがなければ要確認です", 4, ("warning",))
                raise Refuse(f"パスワードが違う（あと {LOCK_AFTER - failures} 回でロック）", "bad_password", remaining=LOCK_AFTER - failures)
            self._set_lock({"failures": 0, "locked_until": 0})
            # 承認の直前に、保存してある中身が digest どおりか確かめる（root 所有だが念のため）
            try:
                self._verify_integrity(m)
            except Refuse as e:
                m["status"] = "failed"
                m["error"] = str(e)
                m["finished_at"] = self.clock()
                self._save(m)
                self.audit("integrity_failed", id=rid)
                raise
            m["status"] = "approved"
            m["approved_at"] = self.clock()
            m["decided_by"] = by
            self._save(m)
            self.audit("approve", id=rid, by=by, digest=m["digest"])
        t = threading.Thread(target=self._execute, args=(rid,), daemon=True)
        self.threads.append(t)
        t.start()
        return {"id": rid, "status": "approved"}

    def _verify_integrity(self, m):
        d = self._dir(m["id"])
        if sha256_file(os.path.join(d, "script.sh")) != m["script_sha256"]:
            raise Refuse("保存したスクリプトが変わっている。実行しない", "tampered")
        for fm in m["files"]:
            p = os.path.join(d, "files", fm["name"])
            if os.path.islink(p) or sha256_file(p) != fm["sha256"]:
                raise Refuse("保存した添付が変わっている。実行しない", "tampered")
        if manifest_digest(m["title"], m["reason"], m["timeout"], m["script_sha256"], m["files"]) != m["digest"]:
            raise Refuse("依頼の記録が変わっている。実行しない", "tampered")

    # ---- 実行 ----
    def _execute(self, rid):
        with self.exec_lock:
            with self.lock:
                m = self._load(rid)
                if m["status"] != "approved":  # 1 依頼 1 回: approved から running に進めるのは 1 度だけ
                    return
                try:
                    self._verify_integrity(m)
                except Refuse as e:
                    m.update(status="failed", error=str(e), finished_at=self.clock())
                    self._save(m)
                    return
                m["status"] = "running"
                m["started_at"] = self.clock()
                self._save(m)
            d = self._dir(rid)
            env = {
                "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
                "HOME": "/root",
                "LANG": "C.UTF-8",
                "PLASMOD_ROOTD_REQUEST_ID": rid,
                "PLASMOD_ROOTD_FILES": os.path.join(d, "files"),
            }
            out = {"stdout": bytearray(), "stderr": bytearray()}
            trunc = {"stdout": False, "stderr": False}
            status, code, err = "done", None, None
            t0 = self.clock()
            try:
                proc = subprocess.Popen(
                    [self.cfg.shell, os.path.join(d, "script.sh")],
                    cwd=os.path.join(d, "files"),
                    env=env,
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    start_new_session=True,
                )

                def drain(name, stream):
                    while True:
                        chunk = stream.read(65536)
                        if not chunk:
                            stream.close()
                            return
                        room = OUTPUT_CAP - len(out[name])
                        if room > 0:
                            out[name].extend(chunk[:room])
                        if len(chunk) > room:
                            trunc[name] = True

                readers = [threading.Thread(target=drain, args=(n, s), daemon=True) for n, s in (("stdout", proc.stdout), ("stderr", proc.stderr))]
                for r in readers:
                    r.start()
                try:
                    code = proc.wait(timeout=m["timeout"])
                except subprocess.TimeoutExpired:
                    status = "timeout"
                    err = f"{m['timeout']} 秒のタイムアウトで止めた"
                    self._kill(proc, signal.SIGTERM)
                    try:
                        code = proc.wait(timeout=5)
                    except subprocess.TimeoutExpired:
                        self._kill(proc, signal.SIGKILL)
                        code = proc.wait()
                # 子プロセスが出力の口を持ち続けても、ここで待ち切る
                for r in readers:
                    r.join(timeout=5)
                self._kill(proc, signal.SIGKILL)  # 取り残しの子孫
                if status == "done" and code != 0:
                    status = "failed"
            except Exception as e:  # noqa: BLE001
                status, err = "failed", f"起動できなかった: {type(e).__name__}"
            t1 = self.clock()
            stdout = bytes(out["stdout"]).decode("utf-8", "replace")
            stderr = bytes(out["stderr"]).decode("utf-8", "replace")
            self._write_log(m, status, code, t0, t1, stdout, stderr, trunc, err)
            with self.lock:
                m = self._load(rid)
                m.update(
                    status=status, exit_code=code, finished_at=t1, duration=round(t1 - t0, 2), stdout=stdout, stderr=stderr,
                    stdout_truncated=trunc["stdout"], stderr_truncated=trunc["stderr"],
                )
                if err:
                    m["error"] = err
                self._save(m)
                self.audit("finished", id=rid, status=status, exit_code=code)
            label = {"done": "完了", "failed": "失敗", "timeout": "タイムアウト"}[status]
            self.notifier.send(f"root 作業: {label}", f"{rid} 終了コード {code}", 3 if status == "done" else 4, ("white_check_mark",) if status == "done" else ("x",), "/#/root")

    @staticmethod
    def _kill(proc, sig):
        try:
            os.killpg(proc.pid, sig)
        except (ProcessLookupError, PermissionError):
            pass

    def _write_log(self, m, status, code, t0, t1, stdout, stderr, trunc, err):
        head = (
            f"id: {m['id']}\ntitle: {m['title']}\nrequester: {m['requester']} (uid {m['requester_uid']})\n"
            f"digest: {m['digest']}\napproved_by: {m.get('decided_by')}\nstatus: {status}\nexit_code: {code}\n"
            f"duration: {t1 - t0:.2f}s\n{('error: ' + err + chr(10)) if err else ''}"
        )
        body = f"{head}--- stdout{' (切り詰め)' if trunc['stdout'] else ''} ---\n{stdout}\n--- stderr{' (切り詰め)' if trunc['stderr'] else ''} ---\n{stderr}\n"
        try:
            write_atomic(os.path.join(self.cfg.log_dir, f"{m['id']}.log"), body.encode(), 0o600)
        except OSError:
            pass

    def wait_idle(self, timeout=30):
        """テスト用: 実行スレッドの終了を待つ"""
        for t in list(self.threads):
            t.join(timeout)


