FS_DENY = re.compile(r"(^|/)(\.env[^/]*|auth[^/]*\.json|[^/]*\.db(-[a-z]+)?|[^/]*\.(pem|key|p12)|[^/]*(credential|secret|token)[^/]*|\.git)(/|$)", re.I)
FS_MAX = 256 * 1024


def fs_path(rel):
    rel = rel.strip().lstrip("/")
    if "\0" in rel or len(rel) > 1000:
        die("不正なパス")
    p = os.path.realpath(os.path.join(HERMES_HOME, rel))
    if p != HERMES_HOME and not p.startswith(HERMES_HOME + "/"):
        die("~/.hermes の外は見られない")
    inner = os.path.relpath(p, HERMES_HOME)
    if inner != "." and FS_DENY.search(inner):
        die(f"見せない場所: {inner}")
    return p, ("" if inner == "." else inner)


def fs_list(rel):
    p, inner = fs_path(rel)
    if not os.path.isdir(p):
        die("フォルダではない")
    items = []
    for name in sorted(os.listdir(p))[:500]:
        q = os.path.join(p, name)
        sub = os.path.join(inner, name) if inner else name
        try:
            st = os.lstat(q)
        except OSError:
            continue
        items.append({"name": name, "dir": os.path.isdir(q) and not os.path.islink(q), "size": st.st_size,
                      "mtime": int(st.st_mtime), "locked": bool(FS_DENY.search(sub))})
    items.sort(key=lambda x: (not x["dir"], x["name"].lower()))
    print(json.dumps({"path": inner, "items": items}, ensure_ascii=False))


def fs_read(rel):
    p, inner = fs_path(rel)
    if not os.path.isfile(p):
        die("ファイルではない")
    size = os.path.getsize(p)
    with open(p, "rb") as f:
        data = f.read(FS_MAX)
    binary = b"\0" in data[:8192]
    print(json.dumps({"path": inner, "size": size, "binary": binary, "truncated": size > FS_MAX,
                      "text": "" if binary else data.decode("utf-8", errors="replace")}, ensure_ascii=False))


MEDIA_ROOTS_FILE = "/etc/plasmod-media-roots"   # 任意。1行に1つ、読んでよいフォルダを足す（/home/hermes か /tmp の下だけ）
MEDIA_MAX = 15 * 1024 * 1024


def media_roots():
    roots = [HERMES_HOME]
    try:
        with open(MEDIA_ROOTS_FILE) as f:
            for line in f:
                r = os.path.realpath(line.strip()) if line.strip().startswith("/") else ""
                if r and (r.startswith(USER_HOME + "/") or r.startswith("/tmp/")) and r not in roots:
                    roots.append(r)
    except OSError:
        pass
    return roots


def media_read(path):
    """絶対パスのファイルを返す。シンボリックリンクは実体に直してから、許可した場所の中で、鍵・.env・DB などでないことを確かめる。"""
    if not path.startswith("/") or "\0" in path or len(path) > 1000:
        die("不正なパス")
    p = os.path.realpath(path)
    for root in media_roots():
        if p.startswith(root + "/"):
            inner = os.path.relpath(p, root)
            if FS_DENY.search(inner) or FS_DENY.search(p):
                die(f"見せない場所: {inner}")
            break
    else:
        die("許可した場所の外は見られない")
    if not os.path.isfile(p):
        die("ファイルではない")
    if os.path.getsize(p) > MEDIA_MAX:
        die("大きすぎて開けない")
    with open(p, "rb") as f:
        sys.stdout.buffer.write(f.read(MEDIA_MAX + 1))
    sys.stdout.buffer.flush()


ATTACH_ROOT = os.path.join(HERMES_HOME, "kanban", "attachments")
TASK_KEEP = ("id", "title", "body", "assignee", "status", "priority", "created_by", "created_at", "started_at",
             "completed_at", "result", "skills", "model_override", "provider_override", "last_failure_error")


def clip(v, n):
    return v[:n] if isinstance(v, str) else v


def task_detail(tid):
    """hermes kanban show --json を、アプリで見せる形に絞る。添付は一覧（名前・大きさ・パス）だけで、中身は media-read で読む。"""
    r = subprocess.run([HERMES, "kanban", "show", "--json", tid], env=ENV, cwd=USER_HOME, capture_output=True, text=True)
    if r.returncode != 0:
        die((r.stderr or r.stdout).strip()[-2000:] or "hermes kanban show failed", r.returncode)
    try:
        info = json.loads(r.stdout)
    except ValueError:
        die("hermes kanban show の出力が読めない")
    t = info.get("task", info)
    task = {k: t.get(k) for k in TASK_KEEP}
    task["body"] = clip(task["body"], 20000)
    task["result"] = clip(task["result"], 8000)
    comments = [{"author": c.get("author"), "body": clip(c.get("body") or "", 8000), "created_at": c.get("created_at")}
                for c in (info.get("comments") or [])][-300:]
    events = []
    for e in (info.get("events") or [])[-200:]:
        payload = e.get("payload")
        events.append({"kind": e.get("kind"), "created_at": e.get("created_at"), "run_id": e.get("run_id"),
                       "detail": clip(json.dumps(payload, ensure_ascii=False), 600) if payload else None})
    runs = [{"id": x.get("id"), "profile": x.get("profile"), "status": x.get("status"), "outcome": x.get("outcome"),
             "summary": clip(x.get("summary"), 4000), "error": clip(x.get("error"), 2000),
             "started_at": x.get("started_at"), "ended_at": x.get("ended_at")} for x in (info.get("runs") or [])][-50:]
    ids = [i for i in (info.get("parents") or []) + (info.get("children") or []) if isinstance(i, str)]
    titles = {}
    if ids:
        c = db()
        try:
            q = ",".join("?" * len(ids))
            titles = {row["id"]: {"title": row["title"], "status": row["status"], "assignee": row["assignee"]}
                      for row in c.execute(f"SELECT id, title, status, assignee FROM tasks WHERE id IN ({q})", ids)}
        finally:
            c.close()
    rel = lambda i: {"id": i, **titles.get(i, {"title": i, "status": None, "assignee": None})}
    attachments = []
    adir = os.path.realpath(os.path.join(ATTACH_ROOT, tid))
    if adir.startswith(os.path.realpath(ATTACH_ROOT) + "/") and os.path.isdir(adir):
        for name in sorted(os.listdir(adir))[:200]:
            q = os.path.join(adir, name)
            if os.path.isfile(q) and not os.path.islink(q) and not FS_DENY.search(name):
                st = os.stat(q)
                attachments.append({"name": name, "size": st.st_size, "path": q, "mtime": int(st.st_mtime)})
    print(json.dumps({"task": task, "latest_summary": clip(info.get("latest_summary"), 4000), "comments": comments,
                      "events": events, "runs": runs, "parents": [rel(i) for i in info.get("parents") or [] if isinstance(i, str)],
                      "children": [rel(i) for i in info.get("children") or [] if isinstance(i, str)],
                      "attachments": attachments}, ensure_ascii=False))


TEXT_MAX = 16 * 1024


def read_text(path, n=TEXT_MAX):
    try:
        if os.path.isfile(path) and not os.path.islink(path):
            with open(path, "rb") as f:
                return f.read(n).decode("utf-8", errors="replace")
    except OSError:
        pass
    return None


def frontmatter(text):
    """SKILL.md の先頭の --- で囲まれた所から name / description を拾う（YAML の1行の値だけ）"""
    out = {}
    lines = (text or "").splitlines()
    if not lines or lines[0].strip() != "---":
        return out
    for line in lines[1:60]:
        if line.strip() == "---":
            break
        m = re.match(r"^(name|description):\s*(.*)$", line)
        if m:
            out[m.group(1)] = m.group(2).strip().strip("'\"")
    return out


def skills_of(home):
    sdir = os.path.join(home, "skills")
    found = []
    if not os.path.isdir(sdir):
        return found
    for root, dirs, files in os.walk(sdir):
        dirs[:] = sorted(d for d in dirs if not d.startswith(".") and not os.path.islink(os.path.join(root, d)))
        if os.path.relpath(root, sdir).count(os.sep) >= 4:
            dirs[:] = []
        if "SKILL.md" in files:
            path = os.path.join(root, "SKILL.md")
            fm = frontmatter(read_text(path, 4096))
            cat = os.path.relpath(os.path.dirname(root), sdir)
            found.append({"name": fm.get("name") or os.path.basename(root), "description": (fm.get("description") or "")[:300],
                          "category": "" if cat == "." else cat, "path": os.path.relpath(path, HERMES_HOME)})
            if len(found) >= 500:
                break
    return found


