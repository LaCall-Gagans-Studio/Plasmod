#!/usr/bin/env python3
"""plasmod-task: Plasmod のタスク（TASK-173）を AI（ハブのエージェントたち・開発エージェント）から登録・参照する。

見回りで拾ったもの（メール・Beeper・ops）は、カードを直接作らず、ここに「元の ID 付き」で登録する。
同じ元（--source と --key）は何度登録しても 1 件にまとまり、オーナーの判断（完了・不要など）が残る。
BackLog のものだけが、アプリのホームにカードとして出る。状態は BackLog・Todo・AI-Driven・Done の4つ。

BackLog に入れるのは、オーナーに決めてほしい問いだけ。題は問いの形（〜してよいか？）、本文は
「何の話か／選択肢／おすすめ」の3行で、オーナーが読んで分かる言葉にする。
計画の段・子タスクは --status todo（オーナーがやる）か doing（エージェントがやる）で入れる。

  plasmod-task add --source mail --key <スレッドID> --title 題 [--kind reply|confirm|todo] [--url URL]
              [--agent acct] [--propose kanban,task] [--project P] [--due YYYY-MM-DD] [--event-at 時刻] [--parent 親ID]
              [--status inbox|todo|doing] [本文 | 標準入力]
  plasmod-task status ID inbox|todo|doing|done [ひとこと]   # タスクの状態を動かす（誰が登録したものでも）
  plasmod-task find --source mail --key <スレッドID>      # 登録済みか・判断は何か
  plasmod-task show ID|TASK-123
  plasmod-task list [--status inbox,todo,doing,done,dismissed] [--source mail] [-q 語] [-n 件数]
  plasmod-task comment ID 文
  plasmod-task parent ID 親ID|--none          # 親を付ける・外す（ID は TASK-123 か #の数字）
  plasmod-task link ID 相手ID [--kind related|blocks] [--off]   # つながりを足す・外す（blocks＝ID が相手を止めている）
  plasmod-task links ID                        # 親・子・つながりの一覧
  plasmod-task recur list                      # 繰り返しのルール（週ごと・月ごと・数日ごと）を読む
  plasmod-task recur add --title 題 --cadence weekly:mon [--agent acct] [--lead 1] [--start YYYY-MM-DD] [--project P] [本文]
                                               # 期日が近づくと Todo（--agent があればカンバンで任せて AI-Driven）として自動で出る
                                               # 周期: daily / weekdays / weekly:mon,thu / monthly:25 / every:3（起点から3日ごと）
                                               # 同じ題は1件にまとまる（あれば渡した項目だけ直す）
  plasmod-task recur edit ID [--title ..] [--cadence ..] [--agent ..|--no-agent] [--lead N] [--on|--off]
  plasmod-task recur rm ID                     # ルールを消す（作ったタスクは残る）
  plasmod-task recur skip ID YYYY-MM-DD [--undo]   # その回だけやめる
  plasmod-task merge owner/repo#N [--sha SHA] [メモ]   # マージの承認を頼む（オーナーが画面で承認するとアプリがマージ）
  plasmod-task merge-status owner/repo#N       # 頼んだマージがどうなったか

  共通: --json、--as プロファイル（hermes の中で名乗る。環境変数 PLASMOD_MEMO_AS でも可）
  受け渡しのフォルダ: 環境変数 PLASMOD_MEMO_SPOOL（既定 /var/lib/plasmod-spool/memo。メモと共通）
"""
import argparse
import datetime
import json
import os
import sys
import time
import uuid

SPOOL = os.environ.get("PLASMOD_MEMO_SPOOL", "/var/lib/plasmod-spool/memo")
TIMEOUT = float(os.environ.get("PLASMOD_MEMO_TIMEOUT", "15"))
STATUS_JA = {"inbox": "BackLog", "todo": "Todo", "doing": "AI-Driven", "done": "Done"}
ACTION_JA = {"created": "登録した", "updated": "更新した", "unchanged": "変わらず", "reopened": "BackLog に戻した", "ignored": "登録しなかった"}


def call(op, args, as_=None):
    rid = uuid.uuid4().hex
    tmp = os.path.join(SPOOL, "in", rid + ".tmp")
    req = {"op": op, "args": args}
    if as_:
        req["as"] = as_
    # アプリ（別のユーザー）が読めるよう 0644。in は一覧できず、名前はランダムで、すぐ消される
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
    os.fchmod(fd, 0o644)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(req, f, ensure_ascii=False)
    os.rename(tmp, os.path.join(SPOOL, "in", rid + ".json"))
    out = os.path.join(SPOOL, "out", rid + ".json")
    end = time.time() + TIMEOUT
    while time.time() < end:
        try:
            with open(out, encoding="utf-8") as f:
                reply = json.load(f)
            break
        except FileNotFoundError:
            time.sleep(0.1)
        except json.JSONDecodeError:
            time.sleep(0.05)
    else:
        sys.exit(f"plasmod-task: アプリから返事が来ない（{TIMEOUT:.0f}秒）。アプリが止まっているか、このユーザーは使えない")
    if not reply.get("ok"):
        sys.exit(f"plasmod-task: {reply.get('error')}")
    return reply["result"]


def when(ms):
    return datetime.datetime.fromtimestamp(ms / 1000).strftime("%Y-%m-%d %H:%M") if ms else "-"


def event_ms(v):
    """--event-at: ISO 8601（2026-10-24T09:12:00+09:00）か、ミリ秒・秒の数字"""
    if v is None:
        return None
    if v.isdigit():
        n = int(v)
        return n if n > 10**12 else n * 1000
    return int(datetime.datetime.fromisoformat(v.replace("Z", "+00:00")).timestamp() * 1000)


def ref(v):
    """TASK-123 はそのまま、#12・12 は数字に"""
    v = v.lstrip("#")
    return int(v) if v.isdigit() else v


def status_ja(t):
    return "Done・不要" if t.get("doneReason") == "unneeded" else STATUS_JA.get(t["status"], t["status"])


def line(t):
    extra = " ".join(x for x in [f"[{t['project']}]" if t.get("project") else "", f"期日 {t['due']}" if t.get("due") else ""] if x)
    num = t.get("ref") or f"#{t['id']}"
    return f"{num:<9} {status_ja(t):<8} {t['source']}:{t.get('sourceKey') or '-'}  {t['title']}  {extra}".rstrip()


WD = {"sun": 0, "mon": 1, "tue": 2, "wed": 3, "thu": 4, "fri": 5, "sat": 6, "日": 0, "月": 1, "火": 2, "水": 3, "木": 4, "金": 5, "土": 6}
WD_JA = ["日", "月", "火", "水", "木", "金", "土"]


def cadence(text):
    """daily / weekdays / weekly:mon,thu / monthly:25 / every:3 → アプリの周期"""
    kind, _, rest = text.strip().partition(":")
    kind = kind.lower()
    try:
        if kind in ("daily", "weekdays") and not rest:
            return {"type": kind}
        if kind == "weekly":
            days = [WD[d.strip().lower()] if d.strip().lower() in WD else int(d) for d in rest.split(",") if d.strip()]
            return {"type": "weekly", "days": days}
        if kind == "monthly":
            return {"type": "monthly", "day": int(rest)}
        if kind == "every":
            return {"type": "every", "n": int(rest)}
    except (KeyError, ValueError):
        pass
    sys.exit(f"plasmod-task: 周期が読めない: {text}（daily / weekdays / weekly:mon,thu / monthly:25 / every:3）")


def cadence_ja(c):
    t = c["type"]
    return {"daily": "毎日", "weekdays": "平日"}.get(t) or (
        "毎週 " + "・".join(WD_JA[d] for d in c["days"]) if t == "weekly" else f"毎月 {c['day']}日" if t == "monthly" else f"{c['n']}日ごと"
    )


def rule_line(r):
    who = r.get("agent") or "オーナー"
    return f"#{r['id']} {r['title']}  {cadence_ja(r['cadence'])}・{r['leadDays']}日前から・担当 {who}" + ("" if r["enabled"] else "（停止中）") + (f"・やめた回 {','.join(r['skips'])}" if r.get("skips") else "")


def recur(a, out):
    if a.rcmd == "list":
        r = call("recur.list", {}, a.as_)
        if a.json:
            return out(r)
        for x in r["rules"]:
            print(rule_line(x))
        if not r["rules"]:
            print("（繰り返しのルールは無い）")
        return
    if a.rcmd == "rm":
        r = call("recur.remove", {"id": a.id}, a.as_)
        return out(r) if a.json else print(f"#{a.id} を消した（作ったタスクは残る）")
    if a.rcmd == "skip":
        r = call("recur.skip", {"id": a.id, "day": a.day, "skip": not a.undo}, a.as_)
        return out(r) if a.json else print(("戻した: " if a.undo else "やめた: ") + rule_line(r["rule"]))
    args = {}
    if a.rcmd == "add":
        body = a.body if a.body is not None else ("" if sys.stdin.isatty() else sys.stdin.read())
        args = {"title": a.title, "cadence": cadence(a.cadence), "body": body}
    else:
        args["id"] = a.id
        if a.title is not None:
            args["title"] = a.title
        if a.cadence is not None:
            args["cadence"] = cadence(a.cadence)
        if a.body is not None:
            args["body"] = a.body
        if a.no_agent:
            args["agent"] = ""
        if a.on or a.off:
            args["enabled"] = bool(a.on)
    if a.agent is not None:
        args["agent"] = a.agent
    if a.lead is not None:
        args["leadDays"] = a.lead
    if a.start is not None:
        args["anchor"] = a.start
    if a.project is not None:
        args["project"] = a.project
    r = call("recur.add" if a.rcmd == "add" else "recur.edit", args, a.as_)
    if a.json:
        return out(r)
    print(({"created": "足した", "updated": "直した"}.get(r["action"], r["action"])) + ": " + rule_line(r["rule"]))


def main():
    p = argparse.ArgumentParser(prog="plasmod-task", description="Plasmod のタスクを登録・参照する")
    p.add_argument("--json", action="store_true")
    p.add_argument("--as", dest="as_", default=os.environ.get("PLASMOD_MEMO_AS"))
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("habits", help="ルーティーンと今日のチェックを読む（読むだけ）")
    s = sub.add_parser("add", help="登録（同じ元は1件にまとまる）")
    s.add_argument("--source", required=True, help="mail / beeper / ops など")
    s.add_argument("--key", required=True, help="元の ID（メールのスレッド ID・Beeper のチャット+メッセージ ID・TASK-123・ops の項目+日付）")
    s.add_argument("--title", required=True)
    s.add_argument("--kind", default="todo", choices=["reply", "confirm", "todo", "ops"])
    s.add_argument("--url")
    s.add_argument("--agent", help="「任せる」の渡し先（acct / design / dev / default）")
    s.add_argument("--propose", default="", help="kanban,task（task＝オーナーのタスクに残す）")
    s.add_argument("--project")
    s.add_argument("--due", help="YYYY-MM-DD")
    s.add_argument("--event-at", help="元の最後の動きの時刻（新しい返信が来た時刻など）")
    s.add_argument("--parent", help="親のタスク（TASK-123 か #の数字）")
    s.add_argument("--status", default="inbox", choices=["inbox", "todo", "doing"], help="新しく作るときの状態。BackLog（既定）はオーナーに決めてほしい問いだけ。計画の子は todo（オーナー）か doing（エージェント）")
    s.add_argument("body", nargs="?")

    s = sub.add_parser("recur", help="繰り返しのルール（週ごと・月ごと・数日ごとに、タスクが自動で出る）")
    rs = s.add_subparsers(dest="rcmd", required=True)
    rs.add_parser("list", help="ルールの一覧")
    r = rs.add_parser("add", help="足す（同じ題は1件にまとまる）")
    r.add_argument("--title", required=True)
    r.add_argument("--cadence", required=True, help="daily / weekdays / weekly:mon,thu / monthly:25 / every:3")
    r.add_argument("--agent", help="担当のエージェント。あれば浮上と同時にカンバンで任せる（AI-Driven）。無ければオーナーの Todo")
    r.add_argument("--lead", type=int, help="期日の何日前に出すか（既定 0）")
    r.add_argument("--start", help="数え始める日 YYYY-MM-DD（every は起点）")
    r.add_argument("--project")
    r.add_argument("body", nargs="?")
    r = rs.add_parser("edit", help="直す（渡した項目だけ変わる）")
    r.add_argument("id", type=int)
    r.add_argument("--title")
    r.add_argument("--cadence")
    r.add_argument("--agent")
    r.add_argument("--no-agent", action="store_true", help="担当を外してオーナーの Todo に戻す")
    r.add_argument("--lead", type=int)
    r.add_argument("--start")
    r.add_argument("--project")
    r.add_argument("--body")
    g = r.add_mutually_exclusive_group()
    g.add_argument("--on", action="store_true")
    g.add_argument("--off", action="store_true")
    r = rs.add_parser("rm", help="消す（作ったタスクは残る）")
    r.add_argument("id", type=int)
    r = rs.add_parser("skip", help="その回だけやめる")
    r.add_argument("id", type=int)
    r.add_argument("day", help="YYYY-MM-DD")
    r.add_argument("--undo", action="store_true", help="やめたのを戻す")

    s = sub.add_parser("status", help="タスクの状態を動かす（誰が登録したものでも）")
    s.add_argument("id", help="TASK-123 か #の数字")
    s.add_argument("status", choices=["inbox", "todo", "doing", "done"])
    s.add_argument("note", nargs="?", default="")

    s = sub.add_parser("find", help="元の ID で探す")
    s.add_argument("--source", required=True)
    s.add_argument("--key", required=True)

    s = sub.add_parser("show")
    s.add_argument("id", help="タスクの番号（TASK-123）か #の数字")

    s = sub.add_parser("list")
    s.add_argument("--status", help="カンマ区切り。既定は開いているもの（inbox,todo,doing）")
    s.add_argument("--source")
    s.add_argument("-q", "--query")
    s.add_argument("-n", "--limit", type=int, default=50)

    s = sub.add_parser("comment")
    s.add_argument("id", type=int)
    s.add_argument("text", nargs="?")

    s = sub.add_parser("parent", help="親を付ける・外す")
    s.add_argument("id", help="TASK-123 か #の数字")
    s.add_argument("parent", nargs="?", help="親（TASK-123 か #の数字）")
    s.add_argument("--none", action="store_true", help="親を外す")

    s = sub.add_parser("link", help="つながりを足す・外す")
    s.add_argument("id")
    s.add_argument("other")
    s.add_argument("--kind", default="related", choices=["related", "blocks"])
    s.add_argument("--off", action="store_true", help="外す")

    s = sub.add_parser("links", help="親・子・つながり")
    s.add_argument("id")
    s = sub.add_parser("merge", help="マージの承認を頼む。マージは、オーナーが画面で承認したときにアプリがする")
    s.add_argument("pr", help="owner/repo#番号")
    s.add_argument("--sha", help="頼む commit（省略すると今の head）。違えば断られる")
    s.add_argument("note", nargs="?", default="", help="オーナーへのひとこと")
    s = sub.add_parser("merge-status", help="頼んだマージがどうなったか")
    s.add_argument("pr", help="owner/repo#番号")

    a = p.parse_args()
    out = lambda r: print(json.dumps(r, ensure_ascii=False, indent=2))  # noqa: E731
    if a.cmd == "habits":
        r = call("habit.list", {}, a.as_)
        if a.json:
            return out(r)
        print(f"今日 {r['today']}")
        for h in r["habits"]:
            print(f"[{'x' if h['doneToday'] else ' '}] {h['name']}（{h['streak']} 日連続・計 {h['total']} 回）")
        if not r["habits"]:
            print("（ルーティーンは無い）")
        return
    if a.cmd == "recur":
        return recur(a, out)
    if a.cmd == "add":
        body = a.body if a.body is not None else ("" if sys.stdin.isatty() else sys.stdin.read())
        r = call(
            "task.upsert",
            {
                "source": a.source,
                "key": a.key,
                "title": a.title,
                "body": body,
                "kind": a.kind,
                "url": a.url,
                "agent": a.agent,
                "propose": [x.strip() for x in a.propose.split(",") if x.strip()],
                "project": a.project,
                "due": a.due,
                "eventAt": event_ms(a.event_at),
                **({"parent": ref(a.parent)} if a.parent else {}),
                **({"status": a.status} if a.status != "inbox" else {}),
            },
            a.as_,
        )
        if a.json:
            return out(r)
        t = r["task"]
        print(f"{ACTION_JA.get(r['action'], r['action'])}: {t.get('ref') or '#' + str(t['id'])}（{status_ja(t)}）{t['title']}" + (f" — {r['reason']}" if r.get("reason") else ""))
        return
    if a.cmd in ("find", "show"):
        r = call("task.find", {"source": a.source, "key": a.key}, a.as_) if a.cmd == "find" else call("task.get", {"id": a.id if not a.id.isdigit() else int(a.id)}, a.as_)
        if a.json:
            return out(r)
        if r is None:
            return print("（登録されていない）")
        print(line(r))
        if r.get("url"):
            print(r["url"])
        if r.get("kanbanId"):
            print(f"カンバン: {r['kanbanId']}")
        print()
        print(r["body"])
        print("\n--- 記録")
        for e in r.get("events", []):
            print(f"{when(e['at'])}  {e['kind']:<8} {e['author']:<16} {e['text']}")
        return
    if a.cmd == "list":
        args = {"limit": a.limit}
        if a.status:
            args["status"] = [x.strip() for x in a.status.split(",") if x.strip()]
        if a.source:
            args["source"] = a.source
        if a.query:
            args["q"] = a.query
        r = call("task.list", args, a.as_)
        if a.json:
            return out(r)
        for t in r:
            print(line(t))
        if not r:
            print("（当てはまるタスクは無い）")
        return
    if a.cmd in ("merge", "merge-status"):
        if a.cmd == "merge":
            r = call("merge.request", {"pr": a.pr, "note": a.note, **({"sha": a.sha} if a.sha else {})}, a.as_)
        else:
            r = call("merge.status", {"pr": a.pr}, a.as_)
        if a.json:
            return out(r)
        q = r.get("request")
        if not q:
            print("（まだ頼んでいない）")
        else:
            ja = {"pending": "承認待ち", "merged": "マージ済み", "rejected": "取り下げ・差し戻し", "failed": "失敗"}.get(q["status"], q["status"])
            print(f"{q['repo']}#{q['number']} {q['sha'][:7]}: {ja}" + (f" — {q['result']}" if q.get("result") else ""))
        if not r.get("enabled"):
            print("※ このアプリにはマージ用のトークンが無いので、画面からは承認できない（従来どおり、頼まれた側が承認ボタンでマージする）")
        return
    if a.cmd == "status":
        r = call("task.status", {"id": ref(a.id), "status": a.status, "note": a.note}, a.as_)
        return print(json.dumps(r, ensure_ascii=False, indent=2) if a.json else line(r))
    if a.cmd == "parent":
        if a.none == bool(a.parent):
            sys.exit("plasmod-task: 親の ID か --none のどちらか一つを指定する")
        r = call("task.parent", {"id": ref(a.id), "parent": None if a.none else ref(a.parent)}, a.as_)
        if a.json:
            return out(r)
        return print(line(r) + ("" if r.get("parentId") else "（親なし）"))
    if a.cmd in ("link", "links"):
        if a.cmd == "link":
            r = call("task.link", {"a": ref(a.id), "b": ref(a.other), "kind": a.kind, "on": not a.off}, a.as_)
        else:
            r = call("task.links", {"id": ref(a.id)}, a.as_)
        if a.json:
            return out(r)
        for label, k in (("親", "parent"), ("子", "children"), ("止めている", "blocks"), ("止められている", "blockedBy"), ("関連", "related")):
            v = r.get(k)
            items = [v] if isinstance(v, dict) else (v or [])
            if items:
                print(f"{label}:")
                for t in items:
                    print("  " + line(t))
        if not any(r.get(k) for k in ("parent", "children", "blocks", "blockedBy", "related")):
            print("（親・子・つながりは無い）")
        return
    text = a.text if a.text is not None else sys.stdin.read()
    r = call("task.comment", {"id": a.id, "text": text}, a.as_)
    print(json.dumps(r, ensure_ascii=False, indent=2) if a.json else line(r))


if __name__ == "__main__":
    main()
